{
  "scenarios": [
    {
      "name": "an open swap offers Cover it to another adult, never to its requester or a child",
      "members": { "driver": "adult", "kid": "child", "helper": "admin" },
      "steps": [
        { "action": "seedRaw",
          "sql": "INSERT INTO app_carpool__carpools (id, name, pickup_time, weekdays, driver_order, created_by, created_at, archived) VALUES ('cp-ui', ?, '15:30', ?, ?, ?, '2026-08-01T09:00:00Z', 0)",
          "params": ["Swim Team Run", "1,3", "[]", "{{driver}}"] },
        { "action": "seedRaw",
          "sql": "INSERT INTO app_carpool__assignments (id, carpool_id, date, driver_id, status, created_at, updated_at) VALUES ('a-swap', 'cp-ui', date('now', '+7 day'), ?, 'scheduled', '2026-08-01T09:00:00Z', '2026-08-01T09:00:00Z'), ('a-plain', 'cp-ui', date('now', '+8 day'), ?, 'scheduled', '2026-08-01T09:00:00Z', '2026-08-01T09:00:00Z')",
          "params": ["{{driver}}", "{{driver}}"] },
        { "action": "seedRaw",
          "sql": "INSERT INTO app_carpool__swap_requests (id, carpool_id, assignment_id, requested_by, status, created_at, updated_at) VALUES ('sw-ui', 'cp-ui', 'a-swap', ?, 'open', '2026-08-01T10:00:00Z', '2026-08-01T10:00:00Z')",
          "params": ["{{driver}}"] },

        { "action": "open", "as": "driver" },
        { "action": "expectVisible", "as": "driver", "selector": "[data-testid=\"carpool-card\"][data-carpool-id=\"cp-ui\"]" },
        { "action": "click", "as": "driver", "selector": "[data-testid=\"carpool-card\"][data-carpool-id=\"cp-ui\"]" },
        { "action": "expectVisible", "as": "driver", "selector": "[data-testid=\"assignment-row\"][data-assignment-id=\"a-swap\"][data-swap=\"open\"]" },
        { "action": "expectCount", "as": "driver", "selector": "[data-testid=\"accept-swap\"][data-assignment-id=\"a-swap\"]", "count": 0 },
        { "action": "expectVisible", "as": "driver", "selector": "[data-testid=\"request-swap\"][data-assignment-id=\"a-plain\"]" },
        { "action": "expectVisible", "as": "driver", "selector": "[data-testid=\"reassign-driver\"][data-assignment-id=\"a-swap\"]" },

        { "action": "open", "as": "helper" },
        { "action": "expectVisible", "as": "helper", "selector": "[data-testid=\"carpool-card\"][data-carpool-id=\"cp-ui\"]" },
        { "action": "click", "as": "helper", "selector": "[data-testid=\"carpool-card\"][data-carpool-id=\"cp-ui\"]" },
        { "action": "expectVisible", "as": "helper", "selector": "[data-testid=\"assignment-row\"][data-assignment-id=\"a-swap\"][data-swap=\"open\"]" },
        { "action": "expectVisible", "as": "helper", "selector": "[data-testid=\"accept-swap\"][data-assignment-id=\"a-swap\"]" },
        { "action": "expectVisible", "as": "helper", "selector": "[data-testid=\"assignment-row\"][data-assignment-id=\"a-plain\"][data-swap=\"none\"]" },
        { "action": "expectCount", "as": "helper", "selector": "[data-testid=\"request-swap\"][data-assignment-id=\"a-plain\"]", "count": 0 },

        { "action": "open", "as": "kid" },
        { "action": "expectVisible", "as": "kid", "selector": "[data-testid=\"carpool-card\"][data-carpool-id=\"cp-ui\"]" },
        { "action": "click", "as": "kid", "selector": "[data-testid=\"carpool-card\"][data-carpool-id=\"cp-ui\"]" },
        { "action": "expectVisible", "as": "kid", "selector": "[data-testid=\"assignment-row\"][data-assignment-id=\"a-swap\"][data-swap=\"open\"]" },
        { "action": "expectCount", "as": "kid", "selector": "[data-testid=\"accept-swap\"][data-assignment-id=\"a-swap\"]", "count": 0 },
        { "action": "expectVisible", "as": "kid", "selector": "[data-testid=\"assignment-row\"][data-assignment-id=\"a-plain\"][data-swap=\"none\"]" },
        { "action": "expectCount", "as": "kid", "selector": "[data-testid=\"reassign-driver\"]", "count": 0 },
        { "action": "expectText", "as": "kid", "selector": "[data-testid=\"assignment-row\"][data-assignment-id=\"a-plain\"]", "text": "E2E carpool-driver" }
      ]
    },
    {
      "name": "a hub answer that cannot be read is reported in plain words, the day is not shown as skipped, and the retry sticks",
      "members": { "driver": "adult" },
      "steps": [
        { "action": "seedRaw",
          "sql": "INSERT INTO app_carpool__carpools (id, name, pickup_time, weekdays, driver_order, created_by, created_at, archived) VALUES ('cp-fault', ?, '15:30', ?, ?, ?, '2026-08-01T09:00:00Z', 0)",
          "params": ["Swim Team Run", "1,3", "[]", "{{driver}}"] },
        { "action": "seedRaw",
          "sql": "INSERT INTO app_carpool__assignments (id, carpool_id, date, driver_id, status, created_at, updated_at) VALUES ('a-fault', 'cp-fault', date('now', '+7 day'), ?, 'scheduled', '2026-08-01T09:00:00Z', '2026-08-01T09:00:00Z')",
          "params": ["{{driver}}"] },

        { "action": "open", "as": "driver" },
        { "action": "expectVisible", "as": "driver", "selector": "[data-testid=\"carpool-card\"][data-carpool-id=\"cp-fault\"]" },
        { "action": "click", "as": "driver", "selector": "[data-testid=\"carpool-card\"][data-carpool-id=\"cp-fault\"]" },
        { "action": "expectVisible", "as": "driver", "selector": "[data-testid=\"assignment-row\"][data-assignment-id=\"a-fault\"][data-status=\"scheduled\"]" },
        { "action": "expectVisible", "as": "driver", "selector": "[data-testid=\"skip-day\"][data-assignment-id=\"a-fault\"]" },

        { "action": "fault", "as": "driver", "mode": "malformed" },
        { "action": "click", "as": "driver", "selector": "[data-testid=\"skip-day\"][data-assignment-id=\"a-fault\"]" },
        { "action": "expectText", "as": "driver", "selector": "[data-testid=\"error\"]", "text": "Couldn’t reach the hub. Try again." },
        { "action": "expectVisible", "as": "driver", "selector": "[data-testid=\"assignment-row\"][data-assignment-id=\"a-fault\"][data-status=\"scheduled\"]" },
        { "action": "expectVisible", "as": "driver", "selector": "[data-testid=\"skip-day\"][data-assignment-id=\"a-fault\"]" },

        { "action": "fault", "as": "driver", "mode": "none" },
        { "action": "click", "as": "driver", "selector": "[data-testid=\"skip-day\"][data-assignment-id=\"a-fault\"]" },
        { "action": "expectVisible", "as": "driver", "selector": "[data-testid=\"assignment-row\"][data-assignment-id=\"a-fault\"][data-status=\"skipped\"]" },
        { "action": "expectCount", "as": "driver", "selector": "[data-testid=\"error\"]", "count": 0 },

        { "action": "reload", "as": "driver" },
        { "action": "expectVisible", "as": "driver", "selector": "[data-testid=\"carpool-card\"][data-carpool-id=\"cp-fault\"]" },
        { "action": "click", "as": "driver", "selector": "[data-testid=\"carpool-card\"][data-carpool-id=\"cp-fault\"]" },
        { "action": "expectVisible", "as": "driver", "selector": "[data-testid=\"assignment-row\"][data-assignment-id=\"a-fault\"][data-status=\"skipped\"]" },
        { "action": "expectCount", "as": "driver", "selector": "[data-testid=\"skip-day\"][data-assignment-id=\"a-fault\"]", "count": 0 }
      ]
    },
    {
      "name": "covering a swap the hub did not let them claim tells the adult someone else has it, and the request stays open",
      "members": { "driver": "adult", "helper": "admin" },
      "steps": [
        { "action": "seedRaw",
          "sql": "INSERT INTO app_carpool__carpools (id, name, pickup_time, weekdays, driver_order, created_by, created_at, archived) VALUES ('cp-claim', ?, '15:30', ?, ?, ?, '2026-08-01T09:00:00Z', 0)",
          "params": ["Swim Team Run", "1,3", "[]", "{{driver}}"] },
        { "action": "seedRaw",
          "sql": "INSERT INTO app_carpool__assignments (id, carpool_id, date, driver_id, status, created_at, updated_at) VALUES ('a-claim', 'cp-claim', date('now', '+7 day'), ?, 'scheduled', '2026-08-01T09:00:00Z', '2026-08-01T09:00:00Z')",
          "params": ["{{driver}}"] },
        { "action": "seedRaw",
          "sql": "INSERT INTO app_carpool__swap_requests (id, carpool_id, assignment_id, requested_by, status, created_at, updated_at) VALUES ('sw-claim', 'cp-claim', 'a-claim', ?, 'open', '2026-08-01T10:00:00Z', '2026-08-01T10:00:00Z')",
          "params": ["{{driver}}"] },

        { "action": "open", "as": "helper" },
        { "action": "expectVisible", "as": "helper", "selector": "[data-testid=\"carpool-card\"][data-carpool-id=\"cp-claim\"]" },
        { "action": "click", "as": "helper", "selector": "[data-testid=\"carpool-card\"][data-carpool-id=\"cp-claim\"]" },
        { "action": "expectVisible", "as": "helper", "selector": "[data-testid=\"accept-swap\"][data-assignment-id=\"a-claim\"]" },

        { "action": "fault", "as": "helper", "mode": "noop" },
        { "action": "click", "as": "helper", "selector": "[data-testid=\"accept-swap\"][data-assignment-id=\"a-claim\"]" },
        { "action": "dialog", "as": "helper", "answer": "accept", "text": "Cover this drive on" },
        { "action": "expectText", "as": "helper", "selector": "[data-testid=\"error\"]", "text": "Someone else is already covering this drive." },
        { "action": "expectCount", "as": "helper", "selector": "[data-testid=\"notice\"]", "count": 0 },
        { "action": "expectNoText", "as": "helper", "text": "You're covering this drive." },
        { "action": "expectVisible", "as": "helper", "selector": "[data-testid=\"assignment-row\"][data-assignment-id=\"a-claim\"][data-swap=\"open\"]" },

        { "action": "fault", "as": "helper", "mode": "none" },
        { "action": "reload", "as": "helper" },
        { "action": "expectVisible", "as": "helper", "selector": "[data-testid=\"carpool-card\"][data-carpool-id=\"cp-claim\"]" },
        { "action": "click", "as": "helper", "selector": "[data-testid=\"carpool-card\"][data-carpool-id=\"cp-claim\"]" },
        { "action": "expectVisible", "as": "helper", "selector": "[data-testid=\"assignment-row\"][data-assignment-id=\"a-claim\"][data-swap=\"open\"]" },
        { "action": "expectVisible", "as": "helper", "selector": "[data-testid=\"accept-swap\"][data-assignment-id=\"a-claim\"]" },
        { "action": "expectText", "as": "helper", "selector": "[data-testid=\"assignment-row\"][data-assignment-id=\"a-claim\"] [data-testid=\"reassign-driver\"] option:checked", "text": "E2E carpool-driver" }
      ]
    },
    {
      "name": "a skip the hub did not apply is reported and the day stays scheduled; the retry sticks and clears the message",
      "members": { "driver": "adult" },
      "steps": [
        { "action": "seedRaw",
          "sql": "INSERT INTO app_carpool__carpools (id, name, pickup_time, weekdays, driver_order, created_by, created_at, archived) VALUES ('cp-noop', ?, '15:30', ?, ?, ?, '2026-08-01T09:00:00Z', 0)",
          "params": ["Swim Team Run", "1,3", "[]", "{{driver}}"] },
        { "action": "seedRaw",
          "sql": "INSERT INTO app_carpool__assignments (id, carpool_id, date, driver_id, status, created_at, updated_at) VALUES ('a-noop', 'cp-noop', date('now', '+7 day'), ?, 'scheduled', '2026-08-01T09:00:00Z', '2026-08-01T09:00:00Z')",
          "params": ["{{driver}}"] },

        { "action": "open", "as": "driver" },
        { "action": "expectVisible", "as": "driver", "selector": "[data-testid=\"carpool-card\"][data-carpool-id=\"cp-noop\"]" },
        { "action": "click", "as": "driver", "selector": "[data-testid=\"carpool-card\"][data-carpool-id=\"cp-noop\"]" },
        { "action": "expectVisible", "as": "driver", "selector": "[data-testid=\"skip-day\"][data-assignment-id=\"a-noop\"]" },

        { "action": "fault", "as": "driver", "mode": "noop" },
        { "action": "click", "as": "driver", "selector": "[data-testid=\"skip-day\"][data-assignment-id=\"a-noop\"]" },
        { "action": "expectText", "as": "driver", "selector": "[data-testid=\"error\"]", "text": "This day wasn’t updated. Try again." },
        { "action": "expectVisible", "as": "driver", "selector": "[data-testid=\"assignment-row\"][data-assignment-id=\"a-noop\"][data-status=\"scheduled\"]" },
        { "action": "expectVisible", "as": "driver", "selector": "[data-testid=\"skip-day\"][data-assignment-id=\"a-noop\"]" },

        { "action": "fault", "as": "driver", "mode": "none" },
        { "action": "click", "as": "driver", "selector": "[data-testid=\"skip-day\"][data-assignment-id=\"a-noop\"]" },
        { "action": "expectVisible", "as": "driver", "selector": "[data-testid=\"assignment-row\"][data-assignment-id=\"a-noop\"][data-status=\"skipped\"]" },
        { "action": "expectCount", "as": "driver", "selector": "[data-testid=\"error\"]", "count": 0 },

        { "action": "reload", "as": "driver" },
        { "action": "expectVisible", "as": "driver", "selector": "[data-testid=\"carpool-card\"][data-carpool-id=\"cp-noop\"]" },
        { "action": "click", "as": "driver", "selector": "[data-testid=\"carpool-card\"][data-carpool-id=\"cp-noop\"]" },
        { "action": "expectVisible", "as": "driver", "selector": "[data-testid=\"assignment-row\"][data-assignment-id=\"a-noop\"][data-status=\"skipped\"]" }
      ]
    }
  ]
}
